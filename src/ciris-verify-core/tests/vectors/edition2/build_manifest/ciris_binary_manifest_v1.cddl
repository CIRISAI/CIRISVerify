; CC 3.1.2.1 — the build-manifest blob, ciris-binary-manifest/1 (FSD-008 §6; accepted by CC 2026-11-22).
; Written by CIRISVerify for CC to vendor; hand-written. RFC 8610 CDDL over CBOR with CBOR Common
; Deterministic Encoding (draft-ietf-cbor-cde-13, updating RFC 8949), as CC 2.6.1.2 encodes every object.
; The blob is NOT a signed object: no typ, no key, no signature. A build row (provenance:build_manifest:{target}:v1)
; cites it by content hash in evidence_refs; the row is its signature. No floats; no tag-4 decimals.
; The known-answer vectors are CIRISVerify's (build_manifest_blob_v1.json beside this file); this file mints none.
;
; The members are listed in the FSD's order. On the wire CDE orders map keys by the bytewise order of
; their encodings (so "tool" precedes "format"); a reader checks "format" before any other member.

ceg-anything = build-manifest-blob / function-leaf

build-manifest-blob = {
  "format": "ciris-binary-manifest/1",     ; the one value; a reader refuses any other before reading on
  "project": descriptor-project,           ; = the row's build.project
  "version": descriptor-version,           ; = the row's build.version, compared byte for byte
  "target": target-triple,                 ; = the row's dimension {target} = the reader's current target
  "binary_hash": hex-sha256,               ; canonical_binary_hash of the final file (whole file; Mach-O: the __TEXT region)
  "functions_root": bstr .size 32,         ; always: the Merkle root over the function table (below)
  ? "functions": function-table,           ; optional inline table; when present its root equals functions_root
  "generated_at": tstr .size (1..64),      ; the generator's instant (RFC 3339); informative, the row's asserted_at is signed
  "tool": tstr .size (1..128),             ; the generator and its version, e.g. "ciris-manifest-tool/23.6.0"
}

descriptor-project = tstr .regexp "[a-z0-9-]{1,64}"
descriptor-version = tstr .size (1..64)
target-triple = tstr .regexp "[!-~]{1,64}"          ; printable ASCII, no space
hex-sha256 = tstr .regexp "[0-9a-f]{64}"            ; bare lowercase hex, never "sha256:"-prefixed

; One entry per function, keyed by its symbol name. Zero functions is refused.
; offset is relative to the base the runtime resolves for the image that holds the code:
;   ELF     symbol vaddr - p_vaddr of the executable PT_LOAD segment containing .text
;   Mach-O  symbol vaddr - vmaddr of the __TEXT segment (the image's Mach-O header)
;   PE      the export's RVA (relative to the image base, the module handle)
; hash is SHA-256 of the function's size bytes at that offset.
function-table = { + function-name => function-entry }
function-name = tstr .size (1..1024)
function-entry = {
  "offset": uint,
  "size": uint,
  "hash": hex-sha256,
}

; functions_root, the locale tree's construction (CC 3.1.2):
;   leaves      one per function, in the BYTE ORDER OF THE NAMES (not the length-first CDE key order of function-table)
;   leaf        CDE(function-leaf), hashed SHA-256(0x00 || leaf)        (RFC 6962 leaf prefix)
;   parent      SHA-256(0x01 || left || right)                          (RFC 6962 node prefix)
;   padding     a non-power-of-two count is padded by repeating the last leaf to the next power of two
;               (not RFC 6962's split, and not the per-level duplication of CC 6.1.1); one leaf is its own root
function-leaf = {
  "name": function-name,
  "offset": uint,
  "size": uint,
  "hash": hex-sha256,
}
