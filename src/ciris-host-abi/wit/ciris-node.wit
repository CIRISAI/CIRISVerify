// ciris:node — the host interface of the CIRIS WASM node (CIRISServer
// FSD/WASM_NODE.md §4). This file is NORMATIVE: the node module's import
// section may name only the `ciris:node/*` interfaces its world imports
// (§4.1.1), and the import gate (`ciris-abi-gate`) derives its allowlist
// from this file.
//
// Lowering: a CORE wasm module under the canonical ABI, via wit-bindgen
// (§4.2). Not a component.
//
// Conventions that hold across every interface:
//   * Differences between hosts are runtime answers (`carriers`,
//     `can-listen`, `durability`, `describe`), never compile-time branches
//     (§4.1.2).
//   * No ambient authority (§4.1.3): no paths, environment, sockets or
//     processes. Storage is a volume the host opened; files are named
//     inside it.
//   * Storage is synchronous. Network, seal and timers complete as events
//     delivered through the node's `on-event` export (§5.1). Every
//     asynchronous operation takes a `token: u64` chosen by the node, and
//     the event that reports progress carries that token back.
//   * Every source of non-determinism is an import, so a run can be
//     recorded at this boundary and replayed byte for byte (§5.1).

package ciris:node@0.1.0;

/// Types shared by several interfaces. Holds no functions, so it never
/// appears in a module's import section.
interface types {
  /// Failures the host reports. `would-block` is not an error in the
  /// usual sense: it means "try again after the matching event".
  enum errno {
    /// The operation cannot make progress now; wait for its event.
    would-block,
    /// The connection, listener or volume is closed.
    closed,
    /// The peer or the host refused the operation.
    refused,
    /// The named file, key, listener or token does not exist.
    not-found,
    /// The volume or the host's quota is full.
    no-space,
    /// The host, or the person (a declined gesture), denied it.
    denied,
    /// The arguments are malformed or out of range.
    invalid,
    /// This host does not offer the capability.
    unsupported,
    /// The host's I/O failed.
    io,
  }

  /// What the host promises about data written to a volume (§6).
  enum durability {
    /// Survives restart and power loss once `sync` returns.
    persisted,
    /// Usually survives restart; the host makes no promise.
    best-effort,
    /// The host or the user agent may delete it at any time (browser
    /// storage without persistence granted, §6.5).
    evictable,
  }

  /// Host lifecycle transitions, delivered as `event.lifecycle`.
  enum phase {
    /// Visible / interactive (browser tab focused, app in front).
    foreground,
    /// Running but not interactive; the host may throttle ticks.
    background,
    /// The host is about to stop ticking; persist what matters now.
    suspend,
    /// Ticking resumes after a suspend. Monotonic time may have jumped.
    resume,
    /// The host is stopping the node. No further ticks follow.
    shutdown,
  }

  /// Where one half of a hybrid key is used (§8.1(1), §8.2 rows
  /// "at use").
  enum at-use {
    /// The private key never leaves hardware; hardware signs.
    hardware,
    /// Unsealed into the separate vault instance (§8.5) and signed there.
    vault,
    /// Unsealed into host process memory and signed in software.
    software,
  }

  /// How one half of a hybrid key is held when not in use (§8.2 rows
  /// "at rest").
  enum at-rest {
    /// The private key lives in hardware and is never exported.
    hardware,
    /// Sealed under a secret that hardware holds (TPM sealed object,
    /// WebAuthn PRF, platform keystore).
    sealed,
    /// Wrapped under a key derived from a separate token's signature
    /// (`usb_wrapped_mldsa65`: needs the token and the USB medium).
    wrapped,
    /// Sealed under a software-derived key; no hardware binding
    /// (CIRISVerify#325's "software, sealed" floor).
    software-sealed,
    /// Not persisted (in-memory only) or held without protection.
    unprotected,
  }

  /// What the seal (the at-rest protection) is rooted in (§8.2 row
  /// "Seal root").
  enum seal-root {
    /// A TPM 2.0 sealed object (native TPM).
    tpm,
    /// A TPM 2.0 sealed object under a PCR / PolicyAuthorize policy, so
    /// unsealing also requires the measured code (EFI, §8.4).
    tpm-measured,
    /// A deterministic signature by a hardware token, through HKDF
    /// (YubiKey PIV).
    token-signature,
    /// WebAuthn PRF (`hmac-secret`) through HKDF (browser, §8.3).
    webauthn-prf,
    /// A platform keystore (Secure Enclave, Android Keystore).
    platform-keystore,
    /// A software-derived key; no hardware.
    software,
  }

  /// What a sealed key is (`seal.generate`, `signer.generate`).
  enum key-kind {
    /// The CC 2.6.1.7 composite ML-DSA-65-Ed25519 signing key. Public key:
    /// 1984 bytes, mldsaPK(1952) || ed25519PK(32).
    composite,
    /// The node's static X-Wing transit pair for the CC 5.3.3.10 mutual
    /// link handshake, minted fresh for this edition (no transit pair from
    /// an earlier edition carries over). X-Wing
    /// (draft-connolly-cfrg-xwing-kem), made exactly as `onion-hop` is.
    /// Public key: the X-Wing encoding, 1216 bytes,
    /// pk_M = mlkem768EK(1184) || pk_X = x25519PK(32), ML-KEM FIRST. Key
    /// agreement is `xwing-decap`, which returns the X-Wing shared secret.
    transit,
    /// The onion hop key (CC 5.4.6, `outfox-xwing-v1`), published in
    /// `onion_hop_xwing_pubkey` (one 1216-byte member), independent of the `transit` pair: X-Wing
    /// (draft-connolly-cfrg-xwing-kem; decapsulation is identical in -06 and
    /// -11). Public key: the X-Wing encoding, 1216 bytes,
    /// pk_M = mlkem768EK(1184) || pk_X = x25519PK(32), ML-KEM FIRST. Key
    /// agreement is `xwing-decap`, which returns the X-Wing shared secret.
    onion-hop,
  }

  /// Per-half custody truth for one key (§8.1(1)). A node MUST NOT reduce
  /// this to one word for a hybrid key.
  record custody {
    /// The classical (Ed25519) half, at use.
    classical-at-use: at-use,
    /// The classical (Ed25519) half, at rest.
    classical-at-rest: at-rest,
    /// The post-quantum (ML-DSA-65) half, at use.
    pqc-at-use: at-use,
    /// The post-quantum (ML-DSA-65) half, at rest.
    pqc-at-rest: at-rest,
    /// What the at-rest protection is rooted in.
    seal-root: seal-root,
    /// The CC `hardware_custody:{platform}` token (the closed 13-token
    /// vocabulary, `HardwareType::as_platform`) the host measured, or
    /// none when no registered token applies. Hardware is a signal: the
    /// host omits rather than over-claims.
    platform: option<string>,
  }
}

interface clock {
  /// Microseconds since an arbitrary origin. Never goes back. No promise
  /// that it advances across a suspend.
  monotonic-us: func() -> u64;
  /// Unix time in milliseconds, or none until the host has a trusted
  /// time (an EFI RTC is not trusted without roughtime or peer time).
  /// `event.clock-trusted` fires once when this first becomes `some`.
  /// A node MUST NOT stamp signed rows (created_at, attestation times,
  /// consent windows) before that event; transport and replication
  /// receive run on `monotonic-us` and need no wall clock.
  wall-ms: func() -> option<s64>;
}

interface random {
  /// Exactly `len` bytes from a CSPRNG. The host traps rather than
  /// return fewer or weaker bytes; there is no weak fallback.
  fill: func(len: u32) -> list<u8>;
}

/// SYNCHRONOUS on every host (§6).
interface storage {
  use types.{errno, durability};

  /// A store the host opened for the node. Files are small integers
  /// returned by `open`, scoped to the volume.
  resource volume {
    read: func(file: u32, offset: u64, len: u32) -> result<list<u8>, errno>;
    write: func(file: u32, offset: u64, data: list<u8>) -> result<_, errno>;
    sync: func(file: u32) -> result<_, errno>;
    truncate: func(file: u32, size: u64) -> result<_, errno>;
    size: func(file: u32) -> result<u64, errno>;
    open: func(name: string, create: bool) -> result<u32, errno>;
    delete: func(name: string) -> result<_, errno>;
    /// Free space, when the host knows it; drives `disk_pressure`.
    free-bytes: func() -> option<u64>;
    /// What the host promises about data on this volume. (§4.4 has an
    /// interface-level `durability: func() -> durability`; WIT refuses a
    /// function and a type of one name in one interface, so it is a
    /// method of the volume it describes.)
    durability: func() -> durability;
  }

  /// The volume the host opened for this node.
  primary: func() -> volume;
}

/// Readiness is EDGE-TRIGGERED on every host:
///   * `event.readable(token)` fires when a connection (or a datagram
///     socket) goes from nothing to read to something to read. The node MUST
///     `recv` / `recv-from` until `would-block` (or `closed`) before it can
///     expect another `readable`.
///   * `event.writable(token)` fires once after a `send` / `send-to`
///     returned `would-block`, when sending may succeed again.
///   * On a listener, `event.readable(token)` means: `accept` until it
///     returns none. No further `readable` comes for connections that were
///     already pending when it fired.
/// A host MAY deliver a spurious `readable` / `writable`; the node treats
/// each as "try again", never as a promise that the next call succeeds.
///
/// Receive backpressure: the host buffers at most `conn-info.recv-buffer`
/// bytes of unread data per connection. At the cap it pauses reading where
/// the carrier can (TCP, WebSocketStream) and resumes as the node drains.
/// Where the carrier cannot pause (a browser `WebSocket`), the host closes
/// the connection with `closed({token, error})` instead of buffering
/// without bound.
///
/// Shutdown ordering: `closed({token, host-shutdown})` fires exactly once
/// per open stream, and all of them are delivered before
/// `lifecycle(shutdown)`.
interface net {
  use types.{errno};

  /// The connection-shaped carriers. `udp` here is CONNECTED datagrams
  /// only: `dial` fixes the peer and the stream uses message framing; a
  /// host that cannot offer that omits `udp` from `carriers()`. Unconnected
  /// UDP (send-to / recv-from, broadcast, multicast) is the `datagram`
  /// resource below.
  ///
  /// `serial`: baud rate, flow control and KISS settings are HOST
  /// CONFIGURATION, keyed by the `target` path string given to `dial`
  /// (e.g. "/dev/ttyUSB0"); the node names the port, never its settings.
  enum carrier { tcp, udp, ws, webtransport, webrtc, serial, ble, http-fetch }

  /// How a connection delimits data. Reported per connection, not per
  /// carrier: a WebSocket dial can negotiate either.
  enum framing {
    /// An ordered byte stream; `send` may accept a prefix.
    %stream,
    /// Discrete messages; `send` takes a whole message or nothing.
    message,
  }

  /// What the host knows about one connection. Fields the host cannot
  /// know before `connected` read as their empty value until then.
  record conn-info {
    carrier: carrier,
    framing: framing,
    /// Largest message `send` accepts, for message framing (WebTransport
    /// datagrams are about 1200 bytes; sets Reticulum `hw_mtu`). None for
    /// stream framing.
    max-message: option<u32>,
    /// Whether delivered data is reliable and ordered.
    reliable: bool,
    /// The negotiated WebSocket subprotocol; none means the carrier's
    /// default (no subprotocol).
    subprotocol: option<string>,
    /// On an accepted connection, the subprotocols the client requested,
    /// in its order. Empty on a dialled connection.
    peer-subprotocols: list<string>,
    /// The peer's address as the host reports it, opaque to the node
    /// (e.g. "203.0.113.7:4242", "[2001:db8::1]:4242", a BLE address).
    /// None when the host does not know it.
    peer: option<string>,
    /// The host's estimate of the link bitrate, bits per second.
    bitrate-hint: option<u64>,
    /// The most unread bytes the host buffers for this connection (see
    /// "Receive backpressure" above).
    recv-buffer: u32,
  }

  /// Why a connection closed; carried by `event.closed`.
  enum close-reason {
    /// The peer closed it.
    peer-close,
    /// A transport error closed it (including a receive-buffer overflow
    /// on a carrier that cannot pause).
    error,
    /// The host is shutting the node down.
    host-shutdown,
  }

  /// The payload of `event.closed`.
  record close-info {
    token: u64,
    reason: close-reason,
  }

  /// Why a dial or a listener failed; carried by `event.failed` and
  /// `event.listener-failed`.
  enum fail-reason {
    /// The peer actively refused the connection.
    refused,
    /// No route to the target (network or host unreachable).
    unreachable,
    /// The attempt timed out.
    timeout,
    /// The target name did not resolve.
    name-not-resolved,
    /// The host's policy, or the person, denied the connection.
    denied,
    /// Any other failure.
    error,
  }

  /// The payload of `event.failed` and `event.listener-failed`.
  record fail-info {
    token: u64,
    reason: fail-reason,
  }

  /// What to listen on.
  record listen-options {
    /// An IP literal the host interprets ("0.0.0.0", "::1",
    /// "192.0.2.4"); none means all addresses.
    bind: option<string>,
    port: u16,
    /// What the node accepts, in preference order; the host negotiates and
    /// reports the result on `info`. Required empty for carriers without
    /// subprotocols.
    subprotocols: list<string>,
    /// For `ws`: the HTTP upgrade path (e.g. "/rns"); none means any path.
    /// TLS (wss) certificates are HOST CONFIGURATION, never named here.
    ws-path: option<string>,
  }

  /// One network interface, for Reticulum's AutoInterface.
  record net-interface {
    name: string,
    /// IP literals, without port.
    addresses: list<string>,
    /// Whether the interface carries an IPv6 link-local address.
    link-local: bool,
    up: bool,
  }

  carriers: func() -> list<carrier>;    // runtime answer, never a cfg
  can-listen: func(c: carrier) -> bool; // false for all browser carriers (D1)
  /// Whether `bind` (unconnected UDP) is offered. False on browser hosts.
  can-datagram: func() -> bool;
  /// Whether `datagram.multicast-join` is offered. False on browser hosts.
  can-multicast: func() -> bool;
  /// The host's network interfaces (empty when it will not say).
  interfaces: func() -> list<net-interface>;

  /// One connection. Its events carry the token given to `dial` or
  /// `accept`.
  resource %stream {
    info: func() -> conn-info;
    /// Non-blocking. Stream framing: the number of bytes accepted (a
    /// prefix, possibly short). Message framing: 1 when the whole message
    /// was accepted; a message is never split. `would-block` when nothing
    /// was accepted; `event.writable` follows when it may succeed.
    /// `invalid` for a message larger than `max-message`.
    send: func(data: list<u8>) -> result<u32, errno>;
    /// Non-blocking. Stream framing: up to `max` bytes. Message framing:
    /// exactly one whole message, and `invalid` if `max` is smaller than
    /// it. `would-block` when nothing is ready; `event.readable` follows
    /// (edge-triggered: only after a `recv` has returned `would-block`).
    /// `closed` once the peer has closed and everything was read.
    recv: func(max: u32) -> result<list<u8>, errno>;
    close: func();
  }

  /// An unconnected datagram socket (UDP): Reticulum's UDPInterface,
  /// AutoInterface discovery, and direct-link hole punching. Its
  /// `readable` / `writable` events carry the token given to `bind`.
  resource datagram {
    /// Non-blocking send of one whole datagram to `addr` ("host:port", an
    /// IP literal with port). `would-block`, then `event.writable`.
    /// `invalid` for a datagram larger than `max-datagram`.
    send-to: func(addr: string, data: list<u8>) -> result<_, errno>;
    /// Non-blocking receive of one datagram and its source address.
    /// `would-block`, then `event.readable` (edge-triggered).
    recv-from: func() -> result<tuple<string, list<u8>>, errno>;
    /// The bound address ("host:port"), when the host knows it.
    local-addr: func() -> option<string>;
    /// The largest datagram `send-to` accepts.
    max-datagram: func() -> u32;
    /// Join multicast `group` (an IP literal), on `interface` (a
    /// `net-interface.name`) or the host's default. `unsupported` unless
    /// `can-multicast`.
    multicast-join: func(group: string, %interface: option<string>) -> result<_, errno>;
    /// Leave multicast `group`.
    multicast-leave: func(group: string, %interface: option<string>) -> result<_, errno>;
  }

  /// Start a connection. `subprotocols` is the ordered WebSocket
  /// subprotocol offer (e.g. ["rns.hdlc", "rns.raw"]); other carriers
  /// require it empty. `event.connected(token)` or
  /// `event.failed({token, reason})` follows.
  dial: func(c: carrier, target: string, subprotocols: list<string>, token: u64) -> result<%stream, errno>;
  /// Listen. `event.readable(token)` means: `accept` until it returns
  /// none. A listener that fails after this returned ok reports
  /// `event.listener-failed({token, reason})`.
  listen: func(c: carrier, opts: listen-options, token: u64) -> result<u32, errno>;
  /// Take one pending connection, if any. Its events carry `token`.
  accept: func(listener: u32, token: u64) -> result<option<%stream>, errno>;
  /// Stop listening.
  unlisten: func(listener: u32);
  /// Bind an unconnected datagram socket on `port` (0 = any) at the IP
  /// literal `bind` (none = all addresses). `unsupported` unless
  /// `can-datagram`.
  bind: func(bind: option<string>, port: u16, token: u64) -> result<datagram, errno>;
}

/// The hybrid seal (§8).
///
/// DELIBERATE DEVIATION from §4.4's context-free `sign-pqc`: every
/// forward-model signature is the CC 2.6.1.7 composite ML-DSA-65-Ed25519
/// (CIRISVerify#326, `ciris_crypto::composite`), in which ML-DSA-65 signs
///   M' = "CompositeAlgorithmSignatures2025" || "COMPSIG-MLDSA65-Ed25519-SHA512"
///        || 0x00 || SHA-512(msg)
/// with the label `COMPSIG-MLDSA65-Ed25519-SHA512` as its FIPS 204 context
/// string, and Ed25519 signs M' as it is. A context-free `sign-pqc` cannot
/// produce that, so `sign-pqc` takes `ctx`, and `sign-composite` returns
/// the 3373-byte composite (mldsaSig || ed25519Sig) with the host or vault
/// computing M' exactly as `ciris_crypto::composite` does.
///
/// Also deviating from §4.4: `describe` takes a key id (custody differs
/// per key on one host), and §4.4's single-word `tier` enum is replaced
/// by the per-half `custody` record that §8.1(1) requires.
///
/// Seeds never pass through node memory (§8.5, normative). A key is
/// either generated inside the seal (`generate`), or provisioned by the
/// HOST through its own seal root (the host unwraps under the root and
/// installs into the vault with `signer.install`); there is no
/// node-facing call that carries private material.
///
/// Which secrets live where (§8.5 scope):
///   * Long-lived identity secrets (composite, transit, onion-hop) are
///     vault-only. The node names them by `id` and never holds them.
///   * Ephemeral session keys (per-stream chunk keys, per-link E1 AEAD
///     keys, MLS epoch secrets, room/stream DEKs, and the CC 5.3.3.10
///     handshake's initiator ephemeral X-Wing key) may live in node
///     memory. They are derived or freshly drawn, short-lived, zeroized
///     when done, and never in plaintext at rest: if persisted at all,
///     only wrapped via `seal.wrap`. X-Wing encapsulation uses only public
///     keys, so it runs in the node; only decapsulation to a static
///     (transit, onion-hop) goes through `xwing-decap`.
///   * The RNS transport identity (X25519 + Ed25519, used on every link
///     and announce) is node-held at use (reported SoftwareOnly at use)
///     and wrapped at rest via `wrap` / `unwrap` below, under a key the
///     host derives from its seal root at start-up (the same at-rest
///     posture as native's keyring-backed `TransportIdentityKeystore`).
///     Its plaintext never touches `storage`.
///
/// First run versus failure: `public-key(id)` returning `not-found` means
/// the key does not exist yet (first run), and the node calls `generate`.
/// On ANY other error a node MUST NOT regenerate an identity-class key
/// (composite, transit, onion-hop): regenerating rotates a published
/// pair under every peer. It refuses to start instead.
///
/// Asynchronous on every host (a passkey may need a gesture, a session
/// re-wrap needs an async WebCrypto step). Each operation that touches
/// private material takes a node-chosen `token` and returns at once:
/// `ok` means accepted, an `err` means it never started. Completion is
/// `event.sealed(token)`; the node then calls `take(token)` once for the
/// result. MANY tokens may be outstanding at once (a backfill pipelines
/// its signatures), and completions may arrive in any order.
interface seal {
  use types.{errno, custody, key-kind};

  /// Per-half custody of key `id`. Synchronous; reads no secret.
  describe: func(id: string) -> result<custody, errno>;
  /// The public key of `id`, for every `key-kind` (lengths there).
  /// Synchronous; the host keeps public keys outside the seal.
  /// `not-found` means first run (see above).
  public-key: func(id: string) -> result<list<u8>, errno>;
  /// Generate a new key `id` of `kind` inside the seal: the vault draws
  /// the seed from `random` and the host seals it at once. `take(token)`
  /// then returns ONLY the public key (lengths in `key-kind`). The seed
  /// never enters node memory (§8.5). Derivation from the drawn seed:
  ///   * composite: the 64-byte composite private key
  ///     mldsaSeed(32) || ed25519Seed(32), as `ciris_crypto::composite`.
  ///   * transit: a 32-byte X-Wing seed, exactly as onion-hop below (the
  ///     public key is its X-Wing expansion, pk_M || pk_X). Minted fresh
  ///     for this edition; there is no adopt path from an earlier transit
  ///     pair.
  ///   * onion-hop: a 32-byte X-Wing seed, which IS the X-Wing private key
  ///     (draft §5.2); the public key is its X-Wing expansion
  ///     (`ciris_crypto::xwing::XWingSecretKey::from_seed`), returned in
  ///     X-Wing order pk_M || pk_X. A HOST-SIDE adopt of an existing edge
  ///     hop seed must use edge's derivation (edge
  ///     `onion::HopSecret::from_root_seed`: X-Wing seed =
  ///     HKDF-SHA3-256(64-byte root, salt = "", info =
  ///     "ciris-onion-hop/v1/xwing-seed", 32)) and install the resulting
  ///     32-byte X-Wing seed; seed-to-key expansion is not something to
  ///     re-derive differently across drafts.
  /// `invalid` if `id` already exists: generate never overwrites.
  generate: func(id: string, kind: key-kind, token: u64) -> result<_, errno>;
  /// X-Wing decapsulation against a TRANSIT or ONION-HOP key `id`; the
  /// private key never leaves the vault.
  ///   * transit: the CC 5.3.3.10 mutual handshake. The responder
  ///     decapsulates the initiator's encapsulation to its static, and the
  ///     initiator decapsulates the responder's encapsulation to its
  ///     static; the node combines the secrets and runs the handshake KDF.
  ///   * onion-hop: peeling an onion layer (CC 5.4.6).
  /// `ct` is the 1120-byte X-Wing ciphertext ct_M(1088) || ct_X(32); `take(token)`
  /// returns the 32-byte X-Wing shared secret
  ///   SHA3-256(ss_M || ss_X || ct_X || pk_X || "\.//^\")
  /// (`ciris_crypto::xwing::XWingSecretKey::decapsulate`). A well-formed
  /// ciphertext always decapsulates (implicit rejection: a wrong key gives
  /// an unrelated secret, which the AEAD above refuses). `invalid` for a
  /// ciphertext that is not 1120 bytes, and for a composite `id`.
  xwing-decap: func(id: string, ct: list<u8>, token: u64) -> result<_, errno>;
  /// Ed25519 over `msg` as it is (64 bytes). Kept for non-composite
  /// consumers; forward-model signatures use `sign-composite`.
  sign-classical: func(id: string, msg: list<u8>, token: u64) -> result<_, errno>;
  /// ML-DSA-65 over `msg` with FIPS 204 context `ctx` (at most 255
  /// bytes; 3309 bytes out).
  sign-pqc: func(id: string, ctx: list<u8>, msg: list<u8>, token: u64) -> result<_, errno>;
  /// The CC 2.6.1.7 composite over `msg` (3373 bytes out).
  sign-composite: func(id: string, msg: list<u8>, token: u64) -> result<_, errno>;
  /// AEAD-wrap a node-held secret for storage. The host seals `plaintext`
  /// with an AEAD (AES-256-GCM or XChaCha20-Poly1305, the host's choice)
  /// under a key it derives from its seal root, domain-separated by
  /// `label`. The wrapping key never enters node memory. `label` binds the
  /// ciphertext: a blob wrapped under one label does not unwrap under
  /// another. `take(token)` returns the wrapped bytes, which the node
  /// writes to `storage`.
  ///
  /// Labels: any number, each domain-separating its derived key (e.g.
  /// "rns-transport-identity/v1", "rns-ratchets/v1"). A label is at most
  /// 128 bytes of UTF-8; a longer one is `invalid` (at the call).
  ///
  /// Nonces: a FRESH RANDOM nonce per wrap, carried inside the wrapped
  /// bytes. Repeated wraps under one label are expected (ratchets rotate),
  /// and two wraps of the same plaintext give different blobs. The host
  /// MUST NOT use deterministic nonces. With XChaCha20-Poly1305 a random
  /// 24-byte nonce is safe without a counter; with AES-256-GCM a random
  /// 96-bit nonce under the per-label key must stay well within the usual
  /// 2^32 wraps per key.
  ///
  /// Size: plaintext up to 65536 bytes (64 KiB) MUST be accepted; a host
  /// MAY refuse a larger one with `invalid`.
  ///
  /// Intended for node-held secrets such as the Reticulum transport
  /// identity, ratchet keys, or an ephemeral session key that must be
  /// persisted. NEVER for long-lived identity seeds (composite,
  /// transit, onion-hop): those are made by `generate` and live in the
  /// seal / vault.
  wrap: func(label: string, plaintext: list<u8>, token: u64) -> result<_, errno>;
  /// Reverse `wrap`. `take(token)` returns the plaintext, or `denied` /
  /// `invalid` when authentication fails (wrong label, tampered blob, or
  /// a different seal root).
  unwrap: func(label: string, wrapped: list<u8>, token: u64) -> result<_, errno>;
  /// The result of the completed operation `token`: the signature, the
  /// public key for `generate`, the 32-byte shared secret for
  /// `xwing-decap`, the wrapped bytes for `wrap`, or the plaintext for
  /// `unwrap`. `would-block` before `event.sealed(token)`;
  /// `not-found` for an unknown or already-taken token.
  take: func(token: u64) -> result<list<u8>, errno>;
}

interface wake {
  next-deadline: func(us: u64);         // tick me by then (monotonic-us)
  keep-alive: func(reason: string, on: bool);  // advisory
}

interface log {
  /// What a metric sample means.
  enum metric-kind {
    /// A monotonically increasing count; `value` is the increment.
    counter,
    /// A value that goes up and down; `value` is the current reading.
    gauge,
    /// One observation of a distribution.
    histogram,
  }

  /// `level`: 0 error, 1 warn, 2 info, 3 debug, 4 trace.
  %record: func(level: u8, target: string, msg: string);
  /// One sample of the series `name` with `labels` (key, value) pairs
  /// (e.g. [("plane", "replication"), ("peer-class", "seat")]).
  metric: func(name: string, kind: metric-kind, value: f64, labels: list<tuple<string, string>>);
}

world node {
  import clock; import random; import storage; import net;
  import seal;  import wake;   import log;

  use types.{phase};
  use net.{close-info, fail-info};

  /// `readable` / `writable` are edge-triggered (see `net`).
  /// `listener-failed`: a listener failed after `listen` returned ok.
  /// `clock-trusted`: fired once, when `clock.wall-ms` first becomes some.
  /// `closed(host-shutdown)` fires once per open stream before
  /// `lifecycle(shutdown)`.
  variant event {
    readable(u64), writable(u64), connected(u64), failed(fail-info),
    listener-failed(fail-info), closed(close-info), sealed(u64),
    lifecycle(phase), timer, clock-trusted,
  }
  export init: func() -> result<_, string>;
  export tick: func(budget-us: u32) -> u64;   // returns next deadline
  export on-event: func(e: event);
  export api: func(req: list<u8>, local: bool) -> list<u8>;  // in-process /v1
}

/// The vault's own interface (§8.5). Synchronous: the host has already
/// done any gesture or unwrap before calling in. Parses nothing beyond
/// these arguments.
interface signer {
  use types.{errno, key-kind};

  /// Load the seed of key `id` of `kind` into vault memory: composite, 64
  /// bytes mldsaSeed || ed25519Seed; transit and onion-hop, the 32-byte
  /// X-Wing seed (see `seal.generate` for adopting
  /// an edge hop root seed). HOST-SIDE only:
  /// the host unwraps the seed under its seal root and installs it here;
  /// it never passes through the node. This is also how an EXISTING key
  /// is provisioned (import, migration): by the host through its seal
  /// root, with no node-facing call.
  install: func(id: string, kind: key-kind, seed: list<u8>) -> result<_, errno>;
  /// Generate a new key `id` of `kind` from the vault's own `random` and
  /// return its public key, derived exactly as `seal.generate` states.
  /// The host seals the seed out of the vault under its root (outside
  /// this interface); the seed never enters node memory. Backs
  /// `seal.generate`.
  generate: func(id: string, kind: key-kind) -> result<list<u8>, errno>;
  /// X-Wing decapsulation for an installed transit or onion-hop `id`
  /// (composite is `invalid`): returns the
  /// 32-byte shared secret, as `seal.xwing-decap` states. Backs
  /// `seal.xwing-decap`.
  xwing-decap: func(id: string, ct: list<u8>) -> result<list<u8>, errno>;
  /// The public key of an installed `id`, for every `key-kind`.
  public-key: func(id: string) -> result<list<u8>, errno>;
  sign-classical: func(id: string, msg: list<u8>) -> result<list<u8>, errno>;
  sign-pqc: func(id: string, ctx: list<u8>, msg: list<u8>) -> result<list<u8>, errno>;
  sign-composite: func(id: string, msg: list<u8>) -> result<list<u8>, errno>;
  /// Zeroize `id`'s seeds.
  forget: func(id: string);
  /// Zeroize every seed (the idle timer, D10).
  forget-all: func();
}

/// The separate vault instance (§8.5): its own fixed-size linear memory,
/// so seeds never enter the node's. MINIMAL by design: it imports only
/// `log` and `random`. `random` is for `signer.generate` (a fresh key needs
/// fresh seeds); signing itself is deterministic (FIPS 204 §3.4). No
/// storage, network or seal.
world vault {
  import log;
  import random;
  export signer;
}
