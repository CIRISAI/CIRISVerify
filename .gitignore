# Build artifacts
/target/
**/*.rs.bk

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Cargo lock (optional for libraries)
# Cargo.lock

# Test artifacts
*.profraw
*.profdata

# QA runner output (regenerated each run; baseline lives in docs/BENCHMARKS.md)
/QA_REPORT.md

# Secrets and keys
.env
.env.*
*.pem
*.key
*.p12
*.pfx
# Exception: the pinned PUBLIC Yubico Attestation Root 1 CA cert is a deliberate,
# public trust-anchor fixture for the accord custody-chain audit test (no secret).
!accord_ceremony_artifacts/yubico-attestation-root-1.pem
# Exception: BAKED PUBLIC trust anchors (CIRISVerify#227). These are CA root
# certificates `include_str!`'d into the binary and digest-pinned in code — public
# by definition, and the build does not compile without them. Kept as readable PEM
# so a reviewer can audit exactly what the fleet trusts. NEVER put a private key
# here; the `*.pem` rule above stays the default for everything else.
!src/ciris-verify-core/src/roots/*.pem
!src/ciris-verify-core/src/roots/tpm/*.pem
*.der
*.jks
secrets/
*.secret
dist/

# Python build artifacts
__pycache__/
*.egg-info/
bindings/python/build/
bindings/python/.ciris_keys/

# Platform binaries (built by CI, not committed)
bindings/python/ciris_verify/libciris_verify_ffi.so
bindings/python/ciris_verify/libciris_verify_ffi.dylib
bindings/python/ciris_verify/ciris_verify_ffi.dll
android-libs/
.venv/
.claude/
